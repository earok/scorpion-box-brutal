<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Scorpion_Box_Brutal_Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Enable unsafe code execution -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>      
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Core" Version="2026.10.4" />
    <PackageReference Include="Ahwoo.BRUTAL.Glfw" Version="2026.10.5" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui.Backends" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.OpenAl" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.OpenGl" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Strings" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Texture" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Texture.Abstractions" Version="2026.10.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Media\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Cores\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Games\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>  

</Project>
